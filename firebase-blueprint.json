{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and presence information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique identifier (UID)" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name" },
        "email": { "type": "string", "maxLength": 150, "description": "Google email" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "Avatar photo URL" },
        "memberTier": { "type": "string", "maxLength": 50, "description": "VIP / Club Tier" },
        "coinsBalance": { "type": "number", "description": "Rewards coin balance" },
        "status": { "type": "string", "enum": ["online", "offline"], "description": "Current presence status" },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last seen timestamp" }
      },
      "required": ["id", "displayName", "status"]
    },
    "message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Message ID" },
        "chatId": { "type": "string", "maxLength": 128, "description": "ID of the chat" },
        "senderId": { "type": "string", "maxLength": 128, "description": "Sender User ID" },
        "senderName": { "type": "string", "maxLength": 100, "description": "Sender display name" },
        "senderAvatar": { "type": "string", "maxLength": 50, "description": "Avatar initials or icon" },
        "avatarBg": { "type": "string", "maxLength": 50, "description": "Avatar background color class" },
        "text": { "type": "string", "maxLength": 2000, "description": "Message content" },
        "timestamp": { "type": "string", "description": "Display or ISO timestamp" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"], "description": "Delivery status" },
        "image": { "type": "string", "description": "Optional image URL or data URL" },
        "quotedMessage": { "type": "object", "description": "Optional quoted message snippet" },
        "reactions": { "type": "object", "description": "Emoji reactions and counts" }
      },
      "required": ["id", "chatId", "senderId", "text"]
    },
    "chat": {
      "title": "Chat",
      "description": "A conversation between users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Chat ID" },
        "name": { "type": "string", "maxLength": 100, "description": "Chat name" },
        "participants": { "type": "array", "description": "Array of participant User IDs" },
        "lastMessage": { "type": "string", "maxLength": 2000, "description": "Last message text" },
        "lastMessageTime": { "type": "string", "maxLength": 50, "description": "Last message time string" }
      },
      "required": ["id", "participants"]
    },
    "order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Order ID" },
        "trackingNumber": { "type": "string", "maxLength": 128, "description": "Tracking code" },
        "status": { "type": "string", "enum": ["processing", "shipped", "customs", "out_for_delivery", "delivered"], "description": "Order status" },
        "totalEUR": { "type": "number", "description": "Total order amount in EUR" },
        "currency": { "type": "string", "maxLength": 10, "description": "Currency code" },
        "items": { "type": "array", "description": "List of ordered items" },
        "customer": { "type": "object", "description": "Customer shipping info" },
        "date": { "type": "string", "maxLength": 50, "description": "Date placed" },
        "estimatedDelivery": { "type": "string", "maxLength": 50, "description": "Estimated delivery date" }
      },
      "required": ["id", "trackingNumber", "status", "totalEUR"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "user",
      "description": "User presence documents"
    },
    "users/{userId}/orders/{orderId}": {
      "schema": "order",
      "description": "Customer orders subcollection"
    },
    "chats/{chatId}": {
      "schema": "chat",
      "description": "Chat documents"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "message",
      "description": "Message subcollection"
    }
  }
}
